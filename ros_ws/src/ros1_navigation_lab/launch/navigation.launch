<launch>
  <arg name="map_yaml" default="$(find ros1_slam_lab)/maps/lab_map.yaml" />
  <arg name="world_config" default="$(find ros1_navigation_lab)/config/navigation_world.yaml" />
  <arg name="truth_linear_scale" default="1.03" />
  <arg name="truth_angular_scale" default="1.00" />
  <arg name="rviz" default="true" />

  <!--
    复用第 12～16 章已经建立的底盘、URDF、EKF 和激光仿真链。
    world_config 改成导航环境：静态地图不变，但真实 /scan 中额外存在一段临时障碍。
  -->
  <include file="$(find ros1_slam_lab)/launch/base_stack.launch">
    <arg name="world_config" value="$(arg world_config)" />
    <arg name="truth_linear_scale" value="$(arg truth_linear_scale)" />
    <arg name="truth_angular_scale" value="$(arg truth_angular_scale)" />
  </include>

  <!-- 已有地图只由 map_server 提供；AMCL 继续独占 map -> odom。 -->
  <node pkg="map_server"
        type="map_server"
        name="map_server"
        args="$(arg map_yaml)"
        output="screen" />

  <node pkg="amcl"
        type="amcl"
        name="amcl"
        clear_params="true"
        output="screen">
    <rosparam command="load" file="$(find ros1_slam_lab)/config/amcl.yaml" />
    <remap from="scan" to="/scan" />
  </node>

  <!-- move_base 在一个 Node 内装配两套 costmap、Navfn 和 DWA 插件。 -->
  <node pkg="move_base"
        type="move_base"
        name="move_base"
        clear_params="true"
        output="screen">
    <rosparam command="load" file="$(find ros1_navigation_lab)/config/move_base.yaml" />
    <rosparam command="load" file="$(find ros1_navigation_lab)/config/navfn.yaml" />
    <rosparam command="load" file="$(find ros1_navigation_lab)/config/dwa_local_planner.yaml" />

    <rosparam command="load"
              file="$(find ros1_navigation_lab)/config/costmap_common.yaml"
              ns="global_costmap" />
    <rosparam command="load"
              file="$(find ros1_navigation_lab)/config/global_costmap.yaml"
              ns="global_costmap" />

    <rosparam command="load"
              file="$(find ros1_navigation_lab)/config/costmap_common.yaml"
              ns="local_costmap" />
    <rosparam command="load"
              file="$(find ros1_navigation_lab)/config/local_costmap.yaml"
              ns="local_costmap" />
  </node>

  <node if="$(arg rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find ros1_navigation_lab)/rviz/navigation.rviz"
        output="screen" />
</launch>
