<launch>
  <!-- 先启动被测 Node；C++ gtest 会通过 Topic 与它做黑盒集成测试。 -->
  <node pkg="ros1_comm_lab"
        type="testable_node"
        name="testable_node"
        output="screen">
    <param name="multiplier" value="2"/>
    <param name="bias" value="3"/>
    <param name="max_input" value="100"/>
  </node>

  <!-- time-limit 是整个测试进程允许的最长运行时间。 -->
  <test test-name="test_testable_node"
        pkg="ros1_comm_lab"
        type="test_testable_node"
        time-limit="20.0"/>
</launch>
