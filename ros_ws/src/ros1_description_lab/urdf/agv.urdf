<?xml version="1.0"?>
<robot name="ros1_agv_lab">
  <material name="body_gray">
    <color rgba="0.55 0.58 0.62 1.0" />
  </material>

  <material name="sensor_blue">
    <color rgba="0.10 0.35 0.80 1.0" />
  </material>

  <material name="wheel_black">
    <color rgba="0.08 0.08 0.08 1.0" />
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0" />
      <geometry>
        <box size="0.60 0.44 0.20" />
      </geometry>
      <material name="body_gray" />
    </visual>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.10" length="0.05" />
      </geometry>
      <material name="wheel_black" />
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <origin xyz="0 0.25 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.10" length="0.05" />
      </geometry>
      <material name="wheel_black" />
    </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <origin xyz="0 -0.25 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.055" length="0.05" />
      </geometry>
      <material name="sensor_blue" />
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_link" />
    <origin xyz="0.25 0 0.15" rpy="0 0 0" />
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.05 0.02" />
      </geometry>
      <material name="sensor_blue" />
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.10" rpy="0 0 0" />
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.12 0.06" />
      </geometry>
      <material name="sensor_blue" />
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.18 0 0.32" rpy="0 0 0" />
  </joint>
</robot>
