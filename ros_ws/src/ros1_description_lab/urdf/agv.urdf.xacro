<?xml version="1.0"?>
<robot name="ros1_agv_lab" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_camera" default="true" />

  <xacro:property name="pi" value="3.141592653589793" />
  <xacro:property name="body_length" value="0.60" />
  <xacro:property name="body_width" value="0.44" />
  <xacro:property name="body_height" value="0.20" />
  <xacro:property name="wheel_radius" value="0.10" />
  <xacro:property name="wheel_width" value="0.05" />
  <xacro:property name="wheel_y" value="0.25" />

  <xacro:include filename="$(find ros1_description_lab)/urdf/macros/components.xacro" />

  <material name="body_gray">
    <color rgba="0.55 0.58 0.62 1.0" />
  </material>

  <material name="sensor_blue">
    <color rgba="0.10 0.35 0.80 1.0" />
  </material>

  <material name="wheel_black">
    <color rgba="0.08 0.08 0.08 1.0" />
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_height / 2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}" />
      </geometry>
      <material name="body_gray" />
    </visual>
  </link>

  <xacro:wheel side="left"
               y="${wheel_y}"
               wheel_radius="${wheel_radius}"
               wheel_width="${wheel_width}" />

  <xacro:wheel side="right"
               y="${-wheel_y}"
               wheel_radius="${wheel_radius}"
               wheel_width="${wheel_width}" />

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.055" length="0.05" />
      </geometry>
      <material name="sensor_blue" />
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_link" />
    <origin xyz="0.25 0 0.15" rpy="0 0 0" />
  </joint>

  <xacro:box_sensor name="imu"
                    xyz="0 0 0.10"
                    size="0.06 0.05 0.02" />

  <xacro:if value="$(arg use_camera)">
    <xacro:box_sensor name="camera"
                      xyz="0.18 0 0.32"
                      size="0.08 0.12 0.06" />
  </xacro:if>
</robot>
